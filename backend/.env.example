# Токен бота — выдаётся организаторами хакатона, в репозиторий не коммитить
MAX_BOT_TOKEN=

# Базовый URL MAX Bot API — подтверждён в ТЗ, обычно не меняется
MAX_API_BASE_URL=https://platform-api2.max.ru

# Обязателен при заданном PUBLIC_BASE_URL. Создайте отдельный случайный секрет:
# openssl rand -hex 32. Пустое значение на публичном webhook приводит к HTTP 503.
MAX_WEBHOOK_SECRET=

# Публичный HTTPS-адрес backend для регистрации вебхука в MAX (например, ngrok-туннель:
# https://xxxx.ngrok-free.app). Оставьте пустым для локальной разработки без живого MAX.
PUBLIC_BASE_URL=

# Postgres
DATABASE_URL=postgresql://hiring:hiring_dev_password@localhost:5446/hiring?schema=public

PORT=3000

# Для публичного запуска раскомментируйте и задайте случайный ключ (openssl rand -hex 32).
# Если переменная отсутствует, ключ выводится из MAX_BOT_TOKEN.
# SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET

# Технический токен для тестирования REST API жюри/тестировщиками без реального MAX-логина.
# Передаётся как заголовок "Authorization: Bearer <TEST_API_TOKEN>". Оставьте пустым, чтобы отключить.
TEST_API_TOKEN=

# Username бота (без @, как в ссылке https://max.ru/<username>) — нужен для deep-link кнопки
# "Откликнуться из другого чата" на карточке вакансии. Если не задать, backend попробует
# определить его сам через GET /me при старте (см. server.ts/max/botInfo.ts).
MAX_BOT_USERNAME=

# Origin(ы) frontend для CORS, через запятую (например https://myapp.example.com или
# несколько через запятую для dev+прод). Без значения сервер разрешает любой origin;
# для публичного окружения ограничьте список нужными адресами.
# При общем origin frontend и API через Nginx междоменный CORS не нужен.
FRONTEND_ORIGIN=

# Сколько разных людей должны подтвердить выход на работу (кнопка «Приду»), чтобы работодатель
# получил отметку «Надёжный работодатель». По умолчанию 5; для демо можно снизить.
TRUSTED_EMPLOYER_MIN_HIRES=5
