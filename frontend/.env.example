# All VITE_* variables are public. Never put bot tokens or secrets here.
# Empty = same origin (standard Docker/Nginx deployment). Production requires HTTPS.
# For Vite development against a separate backend: http://localhost:3000.
# There is no /api proxy in the current vite.config.ts.
VITE_API_BASE_URL=
# Implemented by backend. Empty also uses this default.
VITE_AUTH_PATH=/api/auth/max
# Optional, e.g. https://max.ru/your_bot (web.max.ru links are also accepted)
VITE_BOT_URL=
# Only works in Vite development builds, never in build/preview.
VITE_ENABLE_DEV_MODE=true
# VITE_* values are embedded at build time. Runtime Nginx environment cannot change them.
