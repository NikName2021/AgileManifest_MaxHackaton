generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  maxUserId          String   @unique @map("max_user_id")
  chatId             String   @map("chat_id")
  displayName        String?  @map("display_name")
  phone              String?
  // Контакт для предзаполнения формы отклика; не путать с phone (номер из MAX).
  applicationContact String?  @map("application_contact")
  // Личный чат с ботом, только из bot_started. chatId — последний увиденный чат, может быть группой.
  dialogChatId       String?  @map("dialog_chat_id")
  createdAt          DateTime @default(now()) @map("created_at")

  vacancies            Vacancy[]         @relation("EmployerVacancies")
  applications         Application[]     @relation("CandidateApplications")
  teamInvites          TeamInvite[]
  teamMarksAsEmployer  TeamMark[]        @relation("TeamMarkEmployer")
  teamMarksAsCandidate TeamMark[]        @relation("TeamMarkCandidate")
  jobSubscriptions     JobSubscription[]
  partnerChannels      PartnerChannel[]

  @@map("users")
}

model Vacancy {
  id              Int       @id @default(autoincrement())
  employerUserId  Int       @map("employer_user_id")
  employer        User      @relation("EmployerVacancies", fields: [employerUserId], references: [id])
  title           String
  regionCode      String    @map("region_code")
  // Код субъекта РФ из справочника (regions/dictionary.ts), распознанный по regionCode; null — не распознан.
  regionSubject   String?   @map("region_subject")
  category        String
  schedule        String
  salaryMin       Int?      @map("salary_min")
  salaryMax       Int?      @map("salary_max")
  description     String?
  // Контакт работодателя для откликнувшихся.
  contactInfo     String?   @map("contact_info")
  // Сколько человек нужно; при найме этого числа вакансия закрывается сама.
  headcount       Int?
  // Подходит студентам: без опыта, гибкий график, на каникулы.
  studentFriendly Boolean   @default(false) @map("student_friendly")
  status          String    @default("draft") // draft | published | closed
  cardMessageId   String?   @map("card_message_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  reminderSentAt  DateTime? @map("reminder_sent_at")
  // От него считается напоминание «нет откликов 48 часов».
  publishedAt     DateTime? @map("published_at")
  closedAt        DateTime? @map("closed_at")
  // Застывший чат для карточки и уведомлений: users.chatId может смениться на групповой.
  employerChatId  String?   @map("employer_chat_id")

  // Блокировка повторной доставки карточки (claimCardRedelivery в publish.ts), защищает от дубля.
  publishDeliveryAttemptAt DateTime? @map("publish_delivery_attempt_at")

  applications Application[]
  teamInvites  TeamInvite[]

  // GET /api/jobs
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("vacancies")
}

model Application {
  id                       Int                @id @default(autoincrement())
  vacancyId                Int                @map("vacancy_id")
  vacancy                  Vacancy            @relation(fields: [vacancyId], references: [id])
  candidateUserId          Int                @map("candidate_user_id")
  candidate                User               @relation("CandidateApplications", fields: [candidateUserId], references: [id])
  status                   String             @default("new") // new | contacted | invited | hired | rejected
  contact                  String?
  // Чат, где прошёл отклик: сюда уходят уведомления о смене статуса.
  candidateChatId          String?            @map("candidate_chat_id")
  // card | link | qr | subscription | channel | miniapp | team; null — отклики до появления поля.
  source                   String?
  // Последний перевод в hired — для списка «Моя бригада».
  hiredAt                  DateTime?          @map("hired_at")
  // Выход на смену: когда, где и подтвердил ли кандидат (pending | confirmed | declined).
  startAt                  DateTime?          @map("start_at")
  shiftNote                String?            @map("shift_note")
  attendance               String?
  attendanceReminderSentAt DateTime?          @map("attendance_reminder_sent_at")
  // Первый просмотр работодателем (список откликов в мини-приложении или смена этапа).
  viewedAt                 DateTime?          @map("viewed_at")
  events                   ApplicationEvent[]
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  @@unique([vacancyId, candidateUserId])
  // GET /api/me/applications
  @@index([candidateUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("applications")
}

model BenchmarkCache {
  regionCode   String   @map("region_code")
  category     String
  avgSalaryMin Int?     @map("avg_salary_min")
  avgSalaryMax Int?     @map("avg_salary_max")
  vacancyCount Int?     @map("vacancy_count")
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@id([regionCode, category])
  @@map("benchmark_cache")
}

model PendingApplication {
  chatId    String   @id @map("chat_id")
  vacancyId Int      @map("vacancy_id")
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pending_applications")
}

model DialogSession {
  chatId    String   @id @map("chat_id")
  step      Int      @default(0)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dialog_sessions")
}

// Приглашение прошлого работника на новую вакансию («Моя бригада»). Одно на пару вакансия–кандидат.
model TeamInvite {
  id              Int       @id @default(autoincrement())
  vacancyId       Int       @map("vacancy_id")
  vacancy         Vacancy   @relation(fields: [vacancyId], references: [id])
  candidateUserId Int       @map("candidate_user_id")
  candidate       User      @relation(fields: [candidateUserId], references: [id])
  status          String    @default("sent") // sent | accepted | declined | expired | undelivered
  createdAt       DateTime  @default(now()) @map("created_at")
  respondedAt     DateTime? @map("responded_at")

  @@unique([vacancyId, candidateUserId])
  @@map("team_invites")
}

// Отметка работодателя о прошлом работнике.
model TeamMark {
  employerUserId  Int      @map("employer_user_id")
  employer        User     @relation("TeamMarkEmployer", fields: [employerUserId], references: [id])
  candidateUserId Int      @map("candidate_user_id")
  candidate       User     @relation("TeamMarkCandidate", fields: [candidateUserId], references: [id])
  reliable        Boolean  @default(false)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([employerUserId, candidateUserId])
  @@map("team_marks")
}

// Подписка кандидата на новые вакансии. Пустое поле — без ограничения по нему.
model JobSubscription {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  regionSubject String?  @map("region_subject")
  category      String?
  schedule      String?
  salaryFrom    Int?     @map("salary_from")
  studentOnly   Boolean  @default(false) @map("student_only")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("job_subscriptions")
}

// Кому вакансия уже разослана по подписке — защита от повторной отправки.
model SubscriptionDelivery {
  vacancyId Int      @map("vacancy_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([vacancyId, userId])
  @@map("subscription_deliveries")
}

// Чат или канал партнёра (вуз, штаб студотрядов, центр занятости), куда добавлен бот.
// Публикация включается владельцем явно; вакансии подбираются по региону и отметке «для студентов».
model PartnerChannel {
  id            Int       @id @default(autoincrement())
  chatId        String    @unique @map("chat_id")
  title         String?
  isChannel     Boolean   @default(false) @map("is_channel")
  ownerUserId   Int       @map("owner_user_id")
  owner         User      @relation(fields: [ownerUserId], references: [id])
  active        Boolean   @default(false)
  regionSubject String?   @map("region_subject")
  studentOnly   Boolean   @default(false) @map("student_only")
  createdAt     DateTime  @default(now()) @map("created_at")
  // Бота удалили из чата — публикации прекращаются.
  removedAt     DateTime? @map("removed_at")

  @@map("partner_channels")
}

model ChannelDelivery {
  vacancyId Int      @map("vacancy_id")
  channelId Int      @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([vacancyId, channelId])
  @@map("channel_deliveries")
}

// Журнал отклика для дорожной карты: applied, status:<этап>, shift_scheduled, shift_confirmed,
// shift_declined. Время каждого события — то, что видит кандидат по наведению на этап.
model ApplicationEvent {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("application_events")
}
