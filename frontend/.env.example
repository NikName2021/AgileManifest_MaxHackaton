# All VITE_* variables are public. Never put bot tokens or secrets here.
# Empty = same origin. Production requires HTTPS.
VITE_API_BASE_URL=
# Implemented by backend. Empty also uses this default.
VITE_AUTH_PATH=/api/auth/max
# Vite dev proxy for /api when VITE_API_BASE_URL is empty. Server-only variable.
API_PROXY_TARGET=http://127.0.0.1:3000
# Optional, e.g. https://max.ru/your_bot (web.max.ru links are also accepted)
VITE_BOT_URL=
# Only works in Vite development builds, never in build/preview.
VITE_ENABLE_DEV_MODE=true
