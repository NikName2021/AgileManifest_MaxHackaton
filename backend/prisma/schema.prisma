generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  maxUserId    String        @unique @map("max_user_id")
  chatId       String        @map("chat_id")
  displayName  String?       @map("display_name")
  phone        String?
  // Сохранённый контакт для предзаполнения формы отклика в кабинете работника (PATCH /api/me).
  // Отдельно от phone: phone — номер из MAX, сюда же кандидат может положить username/ссылку.
  applicationContact String?  @map("application_contact")
  // Личный (dialog) чат пользователя с ботом. В отличие от chatId ("последний увиденный чат",
  // может оказаться группой), проставляется только из bot_started — по документации MAX deep link
  // и кнопка «Начать» всегда открывают приватный чат с ботом. Null — пользователь ещё не запускал
  // бота лично, слать ему уведомления некуда (GET /api/me -> hasBotChat=false).
  dialogChatId String?       @map("dialog_chat_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  vacancies    Vacancy[]     @relation("EmployerVacancies")
  applications Application[] @relation("CandidateApplications")

  @@map("users")
}

model Vacancy {
  id             Int           @id @default(autoincrement())
  employerUserId Int           @map("employer_user_id")
  employer       User          @relation("EmployerVacancies", fields: [employerUserId], references: [id])
  title          String
  regionCode     String        @map("region_code")
  category       String
  schedule       String
  salaryMin      Int?          @map("salary_min")
  salaryMax      Int?          @map("salary_max")
  description    String?
  // Отдельное поле контакта работодателя (раздел 3.3 хендоффа) — раньше контакт дописывался
  // прямо в description произвольным текстом, и REST не мог принять/вернуть его отдельно.
  contactInfo    String?       @map("contact_info")
  status         String        @default("draft") // draft | published | closed
  cardMessageId  String?       @map("card_message_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  reminderSentAt DateTime?     @map("reminder_sent_at")
  // Момент перехода draft -> published. Напоминание «нет откликов 48 часов» считается от него,
  // а не от createdAt: черновик мог пролежать дольше 48 часов до публикации.
  publishedAt    DateTime?     @map("published_at")
  // Чат, где родилась вакансия (или где её опубликовали через REST) — застывает один раз,
  // уведомления воронки идут именно сюда, а не в "текущий" chatId работодателя из users,
  // который может перезаписаться, если работодатель потом напишет боту из группового чата.
  employerChatId String?       @map("employer_chat_id")

  // Атомарная метка "кто-то сейчас пытается (пере)доставить карточку в MAX" (publish.ts, claimCardRedelivery) —
  // без этой метки два параллельных retry публикации одной и той же зависшей (без cardMessageId) вакансии оба могли пройти
  // проверку "cardMessageId пуст" и оба отправить карточку в MAX (раздел 3 фидбека фронтенда). Null —
  // никто сейчас не пытается или предыдущая попытка считается зависшей (>30с, STALE_DELIVERY_ATTEMPT_MS).
  publishDeliveryAttemptAt DateTime? @map("publish_delivery_attempt_at")

  applications   Application[]

  // Каталог работника (GET /api/jobs): фильтр по status + сортировка newest (createdAt DESC, id DESC).
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("vacancies")
}

model Application {
  id              Int      @id @default(autoincrement())
  vacancyId       Int      @map("vacancy_id")
  vacancy         Vacancy  @relation(fields: [vacancyId], references: [id])
  candidateUserId Int      @map("candidate_user_id")
  candidate       User     @relation("CandidateApplications", fields: [candidateUserId], references: [id])
  status          String   @default("new") // new | contacted | invited | hired | rejected
  contact         String?
  // Чат, где кандидат реально прошёл отклик (открыт через deep link — гарантированно личный).
  // Уведомления о смене статуса шлём сюда, а не в "текущий" chatId кандидата из users.
  candidateChatId String?  @map("candidate_chat_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([vacancyId, candidateUserId])
  // История кандидата (GET /api/me/applications): candidateUserId + createdAt DESC, id DESC.
  @@index([candidateUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("applications")
}

model BenchmarkCache {
  regionCode   String   @map("region_code")
  category     String
  avgSalaryMin Int?     @map("avg_salary_min")
  avgSalaryMax Int?     @map("avg_salary_max")
  vacancyCount Int?     @map("vacancy_count")
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@id([regionCode, category])
  @@map("benchmark_cache")
}

model PendingApplication {
  chatId    String   @id @map("chat_id")
  vacancyId Int      @map("vacancy_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pending_applications")
}

model DialogSession {
  chatId    String   @id @map("chat_id")
  step      Int      @default(0)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dialog_sessions")
}
