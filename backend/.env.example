# Токен бота — выдаётся организаторами хакатона, в репозиторий не коммитить
MAX_BOT_TOKEN=

# Базовый URL MAX Bot API — подтверждён в ТЗ, обычно не меняется
MAX_API_BASE_URL=https://platform-api2.max.ru

# Секрет для проверки входящих вебхуков (придумайте свой)
MAX_WEBHOOK_SECRET=change-me

# Публичный HTTPS-адрес backend для регистрации вебхука в MAX (например, ngrok-туннель:
# https://xxxx.ngrok-free.app). Оставьте пустым для локальной разработки без живого MAX.
PUBLIC_BASE_URL=

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hiring?schema=public

PORT=3000

# Секрет для подписи собственных сессионных токенов мини-аппа (см. auth/session.ts).
# Если не задать — выводится детерминированно из MAX_BOT_TOKEN (см. config.ts), но собственный
# случайный секрет надёжнее и переживёт смену токена бота без разлогинивания всех сессий.
SESSION_SECRET=

# Технический токен для тестирования REST API жюри/тестировщиками без реального MAX-логина.
# Передаётся как заголовок "Authorization: Bearer <TEST_API_TOKEN>". Оставьте пустым, чтобы отключить.
TEST_API_TOKEN=change-me-for-jury-testing

# Username бота (без @, как в ссылке https://max.ru/<username>) — нужен для deep-link кнопки
# "Откликнуться из другого чата" на карточке вакансии. Если не задать, backend попробует
# определить его сам через GET /me при старте (см. server.ts/max/botInfo.ts).
MAX_BOT_USERNAME=
